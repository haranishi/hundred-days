{
  "name": "hundred-days",
  "version": "0.1.0",
  "private": true,
  "description": "1日1個Webアプリを作って公開する100日チャレンジ",
  "scripts": {
    "build": "node scripts/sync-shared.mjs --check && node scripts/build.mjs",
    "precheck": "node scripts/precheck.mjs",
    "test:unit": "node --test apps/*/tests/",
    "test:e2e": "playwright test",
    "x:prepare": "node scripts/prepare-x-post.mjs",
    "shared:sync": "node scripts/sync-shared.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
