    "shots": "node tools/shots/capture.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
