{
  "name": "ginrei",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "FROSTLINE（コード名 ginrei）— ブラウザで滑るオリジナルの雪山フリーライド（スノーボード・スキー）",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5183 --strictPort",
