.precheck-ng.txt

# wranglerのローカルキャッシュ（CloudflareアカウントIDを含むため公開しない）
.wrangler/

# ビルド成果物
dist/

# SNS投稿準備のローカル出力（動画の絶対パス等を含む）
.social-output/

# 依存
node_modules/

# Playwrightのローカルテスト成果物
test-results/
playwright-report/
blob-report/

# OS
.DS_Store

# ログ・環境変数
*.log
.env
.env.*
.dev.vars

# 各Dayのデータ変換の元ファイル置き場（入手先は各アプリのREADMEに明記）
apps/*/tools/cache/

# デモ動画に音を重ねるための中間ファイル（record-demo が書き、render-demo-audio が読む）
apps/*/.demo-sound.json

# プロモ動画ツールの生成物（BGMのWAV・プレビュー・本番mp4・1コマ目）。ソースだけを追跡する
apps/*/tools/promo/promo-audio.wav
apps/*/tools/promo/promo.mp4
apps/*/tools/promo/preview-contact.jpg
apps/*/tools/promo/promo-first-frame.png
