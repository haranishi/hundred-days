{
  "name": "futsu-run",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3017",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3017",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cf:build": "NEXT_PUBLIC_SITE_URL=https://futsu-run.haranishi.workers.dev opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview --port 8787",
    "deploy": "npm run cf:build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.14",
    "lucide-react": "0.468.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.1",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "wrangler": "4.155.0"
  },
  "type": "module",
  "allowScripts": {
    "workerd@1.20261023.1": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    }
  }
}
